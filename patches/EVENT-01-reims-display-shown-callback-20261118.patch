+/// Each head's reset changes what it shows and therefore notifies the host once.
+/// Reading a surface does not notify: the host never has to poll for another frame.
+#[test]
+fn a_display_change_notifies_each_head_but_readback_does_not() {
+    let told = Arc::new(Mutex::new(Vec::new()));
+    let notifications = Arc::clone(&told);
+    let device = headless_of(
+        2,
+        GraphicsCallbacks {
+            display_shown: Some(Arc::new(move |head| notifications.lock().push(head))),
+            ..GraphicsCallbacks::default()
+        },
+    );
+    assert!(told.lock().is_empty());
+    let mut pixels = vec![0; 1920 * 1080 * 4];
+    for head in 0..2 {
+        assert_eq!(device.read_display_at(head, &mut pixels).1, Ok(()));
+    }
+    assert!(told.lock().is_empty(), "a read does not create a present");
+    device.reset();
+    eventually(|| told.lock().len() == 2);
+    assert_eq!(*told.lock(), [0, 1]);
+    for head in 0..2 {
+        assert_eq!(device.read_display_at(head, &mut pixels).1, Ok(()));
+    }
+    assert_eq!(*told.lock(), [0, 1]);
+}
+
 /// What the host's cursor callbacks of every display were told, in order: the display, then
 /// what.
 type ToldAt = Arc<Mutex<Vec<(u32, Told)>>>;
