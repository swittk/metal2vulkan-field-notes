+/* Called where a present actually becomes the displayed surface, possibly
+ * while the library holds its present queue's lock. Only an atomic store and
+ * a BH schedule are legal here: GPU readback and QEMU display updates happen
+ * later under the BQL, never on a GPU-completion/service thread.
+ */
+static void reims_graphics_pci_frame_presented_cb(void *ctx, uint32_t display)
+{
+    ReimsGraphicsPCIState *s = ctx;
+
+    if (display >= s->displays) {
+        return;
+    }
+    qatomic_set(&s->heads[display].presented_dirty, 1);
+    qemu_bh_schedule(s->frame_bh);
+}
