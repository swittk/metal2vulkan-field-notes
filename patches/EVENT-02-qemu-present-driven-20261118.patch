+/* Runs on QEMU's main event loop, coalescing notifications from the guest's
+ * presentation threads. Each head has at most one GPU read in flight; a
+ * present during that read remains marked dirty for its completion BH.
+ */
+static void reims_graphics_pci_frame_bh(void *opaque)
+{
+    ReimsGraphicsPCIState *s = opaque;
+    uint32_t i;
+
+    assert(bql_locked());
+    for (i = 0; i < s->displays; i++) {
+        ReimsGraphicsHead *head = &s->heads[i];
