+/* The generic GUI default is 30 ms, which limits a software D-Bus stream
+ * to about 33 frames/s even when its consumer requests 60 frames/s. Expose the
+ * polling cadence independently of the guest display mode. The default stays
+ * unchanged; a streaming launcher can select a shorter interval through QMP
+ * without rebuilding, changing resolution, or changing the guest's vblank.
+ *
+ * QMP property access and listener registration run in the main loop. Updating
+ * the existing listeners here also makes changes effective during a stream,
+ * while new listeners inherit the same interval when they register.
+ */
+static void get_dbus_refresh_interval(Object *o, Visitor *v, const char *name,
+                                     void *opaque, Error **errp)
+{
+    uint64_t value = DBUS_DISPLAY(o)->refresh_interval;
+
+    visit_type_uint64(v, name, &value, errp);
+}
+
+static void set_dbus_refresh_interval(Object *o, Visitor *v, const char *name,
+                                     void *opaque, Error **errp)
+{
+    DBusDisplay *dd = DBUS_DISPLAY(o);
+    uint64_t value;
+    unsigned int i;
+
+    if (!visit_type_uint64(v, name, &value, errp)) {
+        return;
+    }
+    if (value < 1 || value > 1000) {
+        error_setg(errp, "refresh-interval must be between 1 and 1000 ms");
+        return;
+    }
+
+    dd->refresh_interval = value;
+    for (i = 0; i < dd->consoles->len; i++) {
+        dbus_display_console_set_refresh(g_ptr_array_index(dd->consoles, i),
+                                          value);
+    }
+}
+
 static void
 dbus_display_class_init(ObjectClass *oc, const void *data)
 {
     UserCreatableClass *ucc = USER_CREATABLE_CLASS(oc);
 
     ucc->complete = dbus_display_complete;
+    object_class_property_add(oc, "refresh-interval", "uint64", &uint64_type_info,
+                              get_dbus_refresh_interval,
+                              set_dbus_refresh_interval, NULL, NULL);
+    object_class_property_set_description(oc, "refresh-interval",
+        "Software display polling interval in milliseconds (default 30)");
     object_class_property_add_bool(oc, "p2p", get_dbus_p2p, set_dbus_p2p);
     object_class_property_add_str(oc, "addr", get_dbus_addr, set_dbus_addr);
     object_class_property_add_str(oc, "audiodev", get_audiodev, set_audiodev);
