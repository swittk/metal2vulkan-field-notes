+fn bytes_buffer(
+    b: &mut ModuleBuilder,
+    sym: ResourceSlot,
+    u32_: TypeId,
+) -> BResult<GlobalId> {
+    let rta = b.ty(Type::RuntimeArray {
+        elem: u32_,
+        stride: Some(1),
+    })?;
+    let layout = natural_layout(b.types(), LayoutRule::Std430, true, &[rta])?;
+    let block = b.ty(Type::Struct {
+        members: [rta].into(),
+        layout: Some(layout),
+    })?;
+    b.resource(sym, StorageClass::StorageBuffer, block)
+}
+
+/// Write only bytes changed by the command; untouched guest bytes are never loaded or stored.
+fn merge_bytes(f: &mut FunctionBuilder<'_>, current: Value, word: Value, after: Value, differ: Value, u8_: TypeId) -> BResult<()> {
+    let zero = u32_value(f, 0)?;
+    let two = u32_value(f, 2)?;
+    let base = f.binary(BinOp::ShiftLeftLogical, word, two)?;
+    for byte in 0..4 {
+        let lane = u32_value(f, 0xff << (8 * byte))?;
+        let bits = f.binary(BinOp::BitwiseAnd, differ, lane)?;
+        let changed = f.binary(BinOp::INotEqual, bits, zero)?;
+        let store: ArmFn<'_, ()> = Box::new(move |f, _| {
+            let shift = u32_value(f, byte * 8)?;
+            let value = f.binary(BinOp::ShiftRightLogical, after, shift)?;
+            let value = f.convert(ConvOp::UConvert, value, u8_)?;
+            let offset = u32_value(f, byte)?;
+            let place = f.binary(BinOp::IAdd, base, offset)?;
+            let to = f.access_chain(current, &[zero, place])?;
+            f.store(to, value, MemAccess::default())?;
+            Ok(ArmEnd::FallThrough(Vec::new()))
+        });
+        f.if_(&mut (), changed, store, None)?;
+    }
+    Ok(())
+}
