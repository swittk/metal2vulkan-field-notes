+/// Whether sampling a Vulkan image alias is unverified for a second plane
+/// of an exported 10-bit IOSurface. A normal RG16Unorm texture, the first
+/// plane, and any image over ordinary own memory retain their existing route.
+/// This concerns a memory representation, not a GPU model.
+fn requires_exported_chroma_shadow(
+    format: PixelFormat,
+    surface_plane: bool,
+    offset: u64,
+    exported: bool,
+) -> bool {
+    surface_plane && offset != 0 && exported && format == PixelFormat::RG16Unorm
+}
+
+#[cfg(test)]
+mod exported_chroma_alias_tests {
+    use super::requires_exported_chroma_shadow;
+    use metal2vulkan::metal::PixelFormat;
+
+    #[test]
+    fn exported_nonzero_chroma_plane_cannot_use_an_unverified_sampled_image_alias() {
+        let choose = requires_exported_chroma_shadow;
+        assert!(choose(PixelFormat::RG16Unorm, true, 16_588_832, true));
+        assert!(!choose(PixelFormat::RG16Unorm, true, 0, true));
+        assert!(!choose(PixelFormat::RG16Unorm, false, 16_588_832, true));
+        assert!(!choose(PixelFormat::RG16Unorm, true, 16_588_832, false));
+        assert!(!choose(PixelFormat::R16Unorm, true, 16_588_832, true));
+        assert!(!choose(PixelFormat::RG8Unorm, true, 16_588_832, true));
+        assert!(!choose(PixelFormat::RGBA16Float, true, 16_588_832, true));
+    }
+}
